# OpenAI Compatible Configuration
# For OpenAI API
OPENAI_API_KEY=your-openai-api-key

# For custom OpenAI-compatible endpoints (e.g., local models via Ollama, LM Studio, etc.)
# OPENAI_BASE_URL=http://localhost:11434/v1  # Ollama default
# OPENAI_BASE_URL=http://localhost:1234/v1   # LM Studio default

# AICloud GLM-4.5 Model Configuration
AICLOUD_API_KEY=your-aicloud-api-key

# Web Search API (Tavily)
TAVILY_API_KEY=your-tavily-api-key

# Anthropic API (for Claude provider - if enabled in models.yaml)
# ANTHROPIC_API_KEY=your-anthropic-api-key